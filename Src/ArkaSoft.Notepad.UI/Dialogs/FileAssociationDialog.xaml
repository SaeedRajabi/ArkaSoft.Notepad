<Window x:Class="ArkaSoft.Notepad.UI.Dialogs.FileAssociationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Width="460" MinHeight="220"
        MouseLeftButtonDown="Window_DragMove"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Border Background="{DynamicResource C.Surface}" CornerRadius="8"
            BorderBrush="{DynamicResource C.Line}" BorderThickness="1"
            Margin="16" Padding="24,20,24,20"
            Effect="{DynamicResource Fx.Popup}">
        <StackPanel>
            <TextBlock x:Name="DialogTitle" Text="File associations" FontFamily="{DynamicResource F.Ui}"
                       FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource C.Text}" Margin="0,0,0,6"/>
            <TextBlock x:Name="DialogHelp" TextWrapping="Wrap" FontFamily="{DynamicResource F.Ui}"
                       FontSize="12" LineHeight="18" Foreground="{DynamicResource C.Text2}" Margin="0,0,0,12"/>
            <StackPanel x:Name="ExtensionList" Margin="0,0,0,4"/>
            <TextBlock x:Name="HintText" TextWrapping="Wrap" FontFamily="{DynamicResource F.Ui}"
                       FontSize="11.5" Foreground="{DynamicResource C.TextDisabled}" Margin="0,8,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="SettingsButton" MinWidth="150" Click="SettingsButton_Click"/>
                <Button Content="Cancel" MinWidth="90" Margin="8,0,0,0" Click="Cancel_Click"/>
                <Button x:Name="ApplyButton" MinWidth="100" Margin="8,0,0,0"
                        Style="{StaticResource Btn.Accent}" Click="Apply_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
