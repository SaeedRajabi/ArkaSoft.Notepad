<Window x:Class="ArkaSoft.Notepad.UI.Dialogs.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FontFamily="{DynamicResource F.Ui}" FlowDirection="{DynamicResource Ui.Direction}" Language="{DynamicResource Ui.Language}"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Width="440" MinHeight="180"
        MouseLeftButtonDown="Window_DragMove"
        PreviewKeyDown="Window_PreviewKeyDown"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Border Background="{DynamicResource C.Surface}" CornerRadius="8"
            BorderBrush="{DynamicResource C.Line}" BorderThickness="1"
            Margin="16" Padding="24,20,24,20"
            Effect="{DynamicResource Fx.Popup}">
        <StackPanel>
            <TextBlock x:Name="DialogTitle" FontFamily="{DynamicResource F.Ui}" FontSize="18"
                       FontWeight="SemiBold" Foreground="{DynamicResource C.Text}"
                       Margin="0,0,0,12"/>
            <TextBlock x:Name="DialogMessage" TextWrapping="Wrap" FontFamily="{DynamicResource F.Ui}"
                       FontSize="13" LineHeight="20" Foreground="{DynamicResource C.Text}"
                       Margin="0,0,0,4"/>
            <StackPanel x:Name="ButtonPanel" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,20,0,0"/>
        </StackPanel>
    </Border>
</Window>
