<Window x:Class="ArkaSoft.Notepad.UI.Dialogs.RenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Width="430" MinHeight="180"
        MouseLeftButtonDown="Window_DragMove"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Border Background="{DynamicResource C.Surface}" CornerRadius="8"
            BorderBrush="{DynamicResource C.Line}" BorderThickness="1"
            Margin="16" Padding="24,20,24,20"
            Effect="{DynamicResource Fx.Popup}">
        <StackPanel>
            <TextBlock x:Name="DialogTitle" Text="Rename" FontFamily="{DynamicResource F.Ui}" FontSize="18"
                       FontWeight="SemiBold" Foreground="{DynamicResource C.Text}" Margin="0,0,0,4"/>
            <TextBlock x:Name="DialogLabel" Text="Enter the new name and extension."
                       FontFamily="{DynamicResource F.Ui}" FontSize="12"
                       Foreground="{DynamicResource C.Text2}" Margin="0,0,0,12"
                       TextWrapping="Wrap"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="96"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="NameBox" Grid.Column="0" Padding="10,7"/>
                <TextBlock x:Name="DotText" Grid.Column="1" Text="." FontSize="16"
                           FontFamily="{DynamicResource F.Ui}" Foreground="{DynamicResource C.Text2}"
                           VerticalAlignment="Center" Margin="6,0,4,0"/>
                <TextBox x:Name="ExtBox" Grid.Column="2" Padding="10,7"/>
            </Grid>

            <TextBlock x:Name="ErrorText" TextWrapping="Wrap" FontFamily="{DynamicResource F.Ui}"
                       FontSize="12" Foreground="#E74C3C" Margin="0,8,0,0" Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Cancel" MinWidth="100" Click="Cancel_Click"/>
                <Button Content="OK" MinWidth="100" Margin="8,0,0,0"
                        Style="{StaticResource Btn.Accent}" Click="Ok_Click" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
