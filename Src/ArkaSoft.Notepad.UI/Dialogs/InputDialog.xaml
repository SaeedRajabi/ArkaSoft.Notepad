<Window x:Class="ArkaSoft.Notepad.UI.Dialogs.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Width="400" MinHeight="160"
        MouseLeftButtonDown="Window_DragMove"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Border Background="{DynamicResource C.Surface}" CornerRadius="8"
            BorderBrush="{DynamicResource C.Line}" BorderThickness="1"
            Margin="16" Padding="24,20,24,20"
            Effect="{DynamicResource Fx.Popup}">
        <StackPanel>
            <TextBlock x:Name="DialogTitle" FontFamily="{DynamicResource F.Ui}" FontSize="18"
                       FontWeight="SemiBold" Foreground="{DynamicResource C.Text}" Margin="0,0,0,8"/>
            <TextBlock x:Name="DialogLabel" FontFamily="{DynamicResource F.Ui}" FontSize="13"
                       Foreground="{DynamicResource C.Text2}" Margin="0,0,0,10"/>
            <TextBox x:Name="InputBox" Padding="10,7"/>
            <TextBlock x:Name="ErrorText" TextWrapping="Wrap" FontFamily="{DynamicResource F.Ui}"
                       FontSize="12" Foreground="#E74C3C" Margin="0,8,0,0" Visibility="Collapsed"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="CancelButton" Content="Cancel" MinWidth="100" Click="CancelButton_Click"/>
                <Button x:Name="OkButton" Content="OK" MinWidth="100" Margin="8,0,0,0"
                        Style="{StaticResource Btn.Accent}" Click="OkButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
