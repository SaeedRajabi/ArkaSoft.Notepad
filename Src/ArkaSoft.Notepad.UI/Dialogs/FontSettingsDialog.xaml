<Window x:Class="ArkaSoft.Notepad.UI.Dialogs.FontSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource T.FontSettings}"
        FontFamily="{DynamicResource F.Ui}" Foreground="{DynamicResource C.Text}"
        FlowDirection="{DynamicResource Ui.Direction}" Language="{DynamicResource Ui.Language}"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" SizeToContent="Height" MaxHeight="720"
        WindowStartupLocation="CenterOwner" Width="530"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Border Background="{DynamicResource C.Surface}" CornerRadius="8"
            BorderBrush="{DynamicResource C.Line}" BorderThickness="1"
            Margin="16" Padding="24,20" Effect="{DynamicResource Fx.Popup}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="{DynamicResource T.FontSettings}" FontSize="19" FontWeight="SemiBold"
                           MouseLeftButtonDown="Title_DragMove" Margin="0,0,0,8"/>
                <TextBlock Text="{DynamicResource T.FontHelp}" TextWrapping="Wrap"
                           Foreground="{DynamicResource C.Text2}" Margin="0,0,0,14"/>
                <TextBlock Text="{DynamicResource T.InterfaceLanguage}" Margin="0,0,0,5"/>
                <ComboBox x:Name="LanguageBox" FlowDirection="LeftToRight" Margin="0,0,0,12"
                          DisplayMemberPath="Label" SelectedValuePath="Code"/>
                <TextBlock Text="{DynamicResource T.PersianFont}" Margin="0,0,0,5"/>
                <ComboBox x:Name="PersianFontBox" FlowDirection="LeftToRight" Margin="0,0,0,12"
                          IsTextSearchEnabled="True"/>
                <TextBlock Text="{DynamicResource T.EnglishFont}" Margin="0,0,0,5"/>
                <ComboBox x:Name="EnglishFontBox" FlowDirection="LeftToRight" Margin="0,0,0,12"
                          IsTextSearchEnabled="True"/>
                <TextBlock Text="{DynamicResource T.DisplayFont}" Margin="0,0,0,5"/>
                <ComboBox x:Name="DisplayFontBox" FlowDirection="LeftToRight" IsTextSearchEnabled="True"/>
                <Border Background="{DynamicResource C.Control}" CornerRadius="4" Margin="0,14,0,0" Padding="12,8">
                    <StackPanel>
                        <TextBlock x:Name="PersianPreview" Text="سلام، فایل Report.txt آماده است (۱۲۳)."
                                   FlowDirection="RightToLeft" TextAlignment="Right" FontSize="17" TextWrapping="Wrap"/>
                        <TextBlock x:Name="EnglishPreview" Text="Hello — سلام! Version 2.0 (2026)."
                                   FlowDirection="LeftToRight" TextAlignment="Left" FontSize="16" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="DisplayPreview" Text="{DynamicResource T.DisplayPreview}"
                                   FontSize="14" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="{DynamicResource T.DirectionHelp}" TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource C.Text2}" Margin="0,12,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button Content="{DynamicResource T.Cancel}" MinWidth="100" IsCancel="True"/>
                    <Button Content="{DynamicResource T.Save}" Style="{StaticResource Btn.Accent}"
                            MinWidth="100" Margin="8,0,0,0" IsDefault="True" Click="Save_Click"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
