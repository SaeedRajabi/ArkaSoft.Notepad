<UserControl x:Class="ArkaSoft.Notepad.UI.Controls.SidebarPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fs="clr-namespace:ArkaSoft.Notepad.UI.Models"
             xmlns:helpers="clr-namespace:ArkaSoft.Notepad.UI.Helpers"
             Focusable="False">
    <UserControl.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <!-- outline (document structure) item -->
        <HierarchicalDataTemplate DataType="{x:Type helpers:OutlineNode}" ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" Margin="2,1"
                       MouseLeftButtonDown="OutlineItem_Click">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="FontFamily" Value="{DynamicResource F.Ui}"/>
                        <Setter Property="FontSize" Value="12.5"/>
                        <Setter Property="Foreground" Value="{DynamicResource C.Text}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="{DynamicResource C.Accent}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </HierarchicalDataTemplate>

        <!-- file-system item: colored folder / extension badge / inline editor -->
        <HierarchicalDataTemplate DataType="{x:Type fs:FileSystemNode}" ItemsSource="{Binding Children}">
            <Grid>
                <!-- normal row -->
                <StackPanel x:Name="NormalRow" Orientation="Horizontal" Margin="2,1"
                            MouseLeftButtonDown="FsItem_Click">
                    <Grid Width="18" Height="16" VerticalAlignment="Center" Margin="0,0,6,0">
                        <!-- folder: native colored glyphs (closed / open) -->
                        <TextBlock x:Name="FolderClosed" Text="&#xE8B7;" Visibility="Collapsed"
                                   FontFamily="{DynamicResource F.Icons}" FontSize="14"
                                   Foreground="#E8A33D"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock x:Name="FolderOpen" Text="&#xE838;" Visibility="Collapsed"
                                   FontFamily="{DynamicResource F.Icons}" FontSize="14"
                                   Foreground="#F2B95C"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <!-- file: clean colored extension badge -->
                        <Border x:Name="FileBadge" Width="16" Height="16" CornerRadius="3"
                                VerticalAlignment="Center" Visibility="Visible"
                                Background="{Binding IconBrush}">
                            <TextBlock Text="{Binding IconLabel}" FontSize="7.5" FontWeight="SemiBold"
                                       FontFamily="{DynamicResource F.Ui}"
                                       Foreground="{Binding IconForeground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <!-- fallback: generic page glyph -->
                        <TextBlock x:Name="DefaultGlyph" Text="&#xE7C3;" Visibility="Collapsed"
                                   FontFamily="{DynamicResource F.Icons}" FontSize="12"
                                   Foreground="{DynamicResource C.Text2}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                               FontFamily="{DynamicResource F.Ui}" FontSize="12.5"
                               Foreground="{DynamicResource C.Text}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- inline editor row (new file/folder, VS Code style) -->
                <StackPanel x:Name="EditRow" Orientation="Horizontal" Margin="2,1" Visibility="Collapsed">
                    <Grid Width="18" Height="16" VerticalAlignment="Center" Margin="0,0,6,0">
                        <TextBlock Text="&#xE8B7;" FontFamily="{DynamicResource F.Icons}" FontSize="14"
                                   Foreground="#E8A33D" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding IsFolder, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="&#xE7C3;" FontFamily="{DynamicResource F.Icons}" FontSize="12"
                                   Foreground="{DynamicResource C.Text2}" HorizontalAlignment="Center"
                                   VerticalAlignment="Center">
                            <TextBlock.Visibility>
                                <Binding Path="IsFolder" Converter="{StaticResource BoolToVis}" ConverterParameter="invert"/>
                            </TextBlock.Visibility>
                        </TextBlock>
                    </Grid>
                    <TextBox x:Name="EditBox" Width="150" MinHeight="24" Padding="4,2" FontSize="12"
                             VerticalContentAlignment="Center"
                             Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="EditBox_KeyDown" LostFocus="EditBox_LostFocus"
                             Loaded="EditBox_Loaded" TextChanged="EditBox_TextChanged"/>
                </StackPanel>
            </Grid>
            <HierarchicalDataTemplate.Triggers>
                <!-- editing mode swap -->
                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <Setter TargetName="NormalRow" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="EditRow" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding NameError}" Value="True">
                    <Setter TargetName="EditBox" Property="BorderBrush" Value="#E74C3C"/>
                </DataTrigger>
                <!-- folders: colored shape, no badge -->
                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                    <Setter TargetName="FolderClosed" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="FileBadge" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="DefaultGlyph" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsFolder}" Value="True"/>
                        <Condition Binding="{Binding IsExpanded}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="FolderClosed" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="FolderOpen" Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
                <!-- files without a known badge: generic page glyph -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsFolder}" Value="False"/>
                        <Condition Binding="{Binding IconLabel}" Value=""/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="FileBadge" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="DefaultGlyph" Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
                <!-- placeholder shows a dimmed ellipsis only -->
                <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                    <Setter TargetName="DefaultGlyph" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="FileBadge" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="FolderClosed" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </HierarchicalDataTemplate.Triggers>
        </HierarchicalDataTemplate>

        <!-- workspace-only toolbar buttons start disabled -->
        <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource Btn.Icon}">
            <Setter Property="IsEnabled" Value="{Binding HasWorkspace, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- ============ full panel (pinned or auto-open) ============ -->
        <Border x:Name="FullView"
                Background="{DynamicResource C.SurfaceAlt}"
                BorderBrush="{DynamicResource C.Line}" BorderThickness="1,0,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- row 1: title + state buttons -->
                <Grid Grid.Row="0" Background="{DynamicResource C.Window}" Margin="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{DynamicResource T.SidebarTitle}"
                               FontFamily="{DynamicResource F.Ui}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource C.Text2}" VerticalAlignment="Center"
                               Margin="12,0,0,0" TextTrimming="CharacterEllipsis"/>
                    <Button x:Name="PinButton" Grid.Column="1" Style="{StaticResource Btn.Icon}"
                            Width="26" Height="26" FontSize="10" Content="&#xE718;"
                            ToolTip="{DynamicResource T.PinSidebar}"/>
                    <Button x:Name="AutoButton" Grid.Column="2" Style="{StaticResource Btn.Icon}"
                            Width="26" Height="26" FontSize="10" Content="&#xE945;"
                            ToolTip="{DynamicResource T.AutoSidebar}"/>
                    <Button x:Name="CloseButton" Grid.Column="3" Style="{StaticResource Btn.Icon}"
                            Width="26" Height="26" FontSize="10" Content="&#xE8BB;" Margin="0,0,4,0"
                            ToolTip="{DynamicResource T.CloseSidebar}"/>
                </Grid>

                <!-- row 2: workspace toolbar -->
                <Border Grid.Row="1" Background="{DynamicResource C.Window}" Margin="0,0,0,1">
                    <StackPanel Orientation="Horizontal" Margin="6,0,6,0" VerticalAlignment="Center">
                        <Button x:Name="OpenFolderButton" Style="{StaticResource Btn.Icon}"
                                Width="26" Height="26" FontSize="11" Content="&#xE838;"
                                ToolTip="{DynamicResource T.OpenFolder}"/>
                        <Button x:Name="NewFileButton" Style="{StaticResource ToolbarButton}"
                                Width="26" Height="26" FontSize="11" Content="&#xE7C3;" Margin="6,0,0,0"
                                ToolTip="{DynamicResource T.NewFile}"/>
                        <Button x:Name="NewFolderButton" Style="{StaticResource ToolbarButton}"
                                Width="26" Height="26" FontSize="11" Content="&#xE8F4;" Margin="6,0,0,0"
                                ToolTip="{DynamicResource T.NewFolder}"/>
                        <Button x:Name="RefreshButton" Style="{StaticResource ToolbarButton}"
                                Width="26" Height="26" FontSize="11" Content="&#xE72C;" Margin="6,0,0,0"
                                ToolTip="{DynamicResource T.RefreshView}"/>
                    </StackPanel>
                </Border>

                <!-- tree: outline or workspace (implicit templates by item type) -->
                <TreeView Grid.Row="2" x:Name="OutlineTree"
                          Padding="6,6,6,12"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.IsVirtualizing="True"
                          Background="Transparent"/>
                </Grid>
                <Border x:Name="ResizeThumb" Grid.Column="1" Width="5" Background="Transparent"
                        Cursor="SizeWE" MouseLeftButtonDown="ResizeThumb_Down"
                        MouseMove="ResizeThumb_Move" MouseLeftButtonUp="ResizeThumb_Up"
                        MouseEnter="ResizeThumb_Enter" MouseLeave="ResizeThumb_Leave">
                    <Rectangle x:Name="ResizeLine" Width="1" HorizontalAlignment="Center"
                               VerticalAlignment="Stretch" Fill="Transparent"/>
                </Border>
            </Grid>
        </Border>

        <!-- ============ thin hover strip (auto mode, closed) ============ -->
        <Border x:Name="StripView" Visibility="Collapsed"
                Background="Transparent" BorderBrush="{DynamicResource C.Line}"
                BorderThickness="1,0,0,0">
            <Rectangle x:Name="StripBar" Width="3" HorizontalAlignment="Center"
                       VerticalAlignment="Stretch" RadiusX="1.5" RadiusY="1.5"
                       Fill="{DynamicResource C.Line}" Margin="0,8"/>
        </Border>
    </Grid>
</UserControl>
